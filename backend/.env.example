# Copy to backend/.env and adjust.  Without DATABASE_URL / REDIS_URL the backend runs in lite mode
# (SQLite file + in-memory queue) - no installation needed.

# DATABASE_URL=postgresql+psycopg://sla:sla@localhost:5432/sla
# REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
INGEST_API_KEY=replace-with-a-random-key

# AI provider (Gemini). Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
